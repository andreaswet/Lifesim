{
  "name": "lifesim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deep, grounded, text-based life simulator.",
  "scripts": {
    "dev": "vite --configLoader bundle",
    "build": "tsc --noEmit && vite build --configLoader bundle",
    "preview": "vite preview --configLoader bundle",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content": "tsx src/tools/validate-content.ts",
    "batch": "tsx src/tools/batch.ts",
    "replay": "tsx src/tools/replay.ts"
  },
  "dependencies": {
    "preact": "^11.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
