bjectId":"p1","month":24679,"data":{"which":"decade","age":30},"significant":true},"text":"Thirty. You are no longer the youngest person in most rooms.","templateId":"life.decade#0","hidden":false,"sourceClass":"structural"},{"id":"log55","month":24690,"age":30,"fact":{"kind":"year_summary","subjectId":"p1","month":24690,"data":{"age":30,"year":2057,"stage":"early_adulthood","trend":"flat","cause":"aging","illnesses":0,"choices":0,"quiet":false,"highlight":"milestone:decade"},"significant":false},"text":"Age 30. You began a new decade.","templateId":"summary.highlight#7","hidden":false,"sourceClass":"system"},{"id":"log58","month":24697,"age":31,"fact":{"kind":"decision_opened","subjectId":"p1","month":24697,"data":{"event":"activity.slipping","decision":"dec57","optional":true},"significant":false},"text":"The last two months have been crowded, and your training has been the thing that gives. Your shoes have not left the hallway in three weeks.","templateId":"prompt.slipping#0","hidden":false,"sourceClass":"player"},{"id":"log59","month":24698,"age":31,"fact":{"kind":"choice","subjectId":"p1","month":24698,"data":{"which":"routine_protect","lapsed":false},"significant":false},"text":"You put the sessions back in the calendar and treat them like appointments. Something else will have to give.","templateId":"activity.choice#9","hidden":false,"sourceClass":"player"},{"id":"log60","month":24702,"age":31,"fact":{"kind":"year_summary","subjectId":"p1","month":24702,"data":{"age":31,"year":2058,"stage":"midlife","trend":"flat","cause":"aging","illnesses":0,"choices":1,"quiet":false,"highlight":null},"significant":false},"text":"Age 31. A quiet year. The weeks repeat, and you let them.","templateId":"summary.quiet#12","hidden":false,"sourceClass":"system"},{"id":"log61","month":24714,"age":32,"fact":{"kind":"year_summary","subjectId":"p1","month":24714,"data":{"age":32,"year":2059,"stage":"midlife","trend":"flat","cause":"aging","illnesses":0,"choices":0,"quiet":true,"high