ctural"},{"id":"log5","month":24342,"age":1,"fact":{"kind":"year_summary","subjectId":"p1","month":24342,"data":{"age":1,"year":2028,"stage":"early","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":false,"highlight":"milestone:first_steps"},"significant":false},"text":"Age 1. You learned to walk this year, and after that nothing below waist height was safe. Most of the year goes on eating, sleeping and getting bigger.","templateId":"summary.highlight#2","hidden":false,"sourceClass":"system"},{"id":"log6","month":24354,"age":2,"fact":{"kind":"year_summary","subjectId":"p1","month":24354,"data":{"age":2,"year":2029,"stage":"early","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 2. Most of the year goes on eating, sleeping and getting bigger.","templateId":"summary.growing#1","hidden":false,"sourceClass":"system"},{"id":"log7","month":24366,"age":3,"fact":{"kind":"year_summary","subjectId":"p1","month":24366,"data":{"age":3,"year":2030,"stage":"early","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 3. The pencil marks on the door frame move up another two inches.","templateId":"summary.growing#4","hidden":false,"sourceClass":"system"},{"id":"log8","month":24378,"age":4,"fact":{"kind":"year_summary","subjectId":"p1","month":24378,"data":{"age":4,"year":2031,"stage":"early","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 4. You are taller by the end of the year, and stronger, and hungry most of the time.","templateId":"summary.growing#5","hidden":false,"sourceClass":"system"},{"id":"log9","month":24380,"age":5,"fact":{"kind":"milestone","subjectId":"p1","month":24380,"data":{"which":"school_start","age":5},"significant":true},"text":"September. You start kindergarten, with a backpack that reaches the backs of your knees.","templateId":"life.school_start#0","hidden":false,"sourceClass":"structural"},{"id":"log10","month":24390,"age":5,"fact":{"kind":"year_summary","subjectId":"p1","month":24390,"data":{"age":5,"year":2032,"stage":"early","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":false,"highlight":"milestone:school_start"},"significant":false},"text":"Age 5. This was the year you started school. You grow again; last year's shoes no longer fit.","templateId":"summary.highlight#4","hidden":false,"sourceClass":"system"},{"id":"log11","month":24402,"age":6,"fact":{"kind":"year_summary","subjectId":"p1","month":24402,"data":{"age":6,"year":2033,"stage":"childhood","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 6. You are faster than you were a year ago, and you can reach the next shelf up.","templateId":"summary.growing#3","hidden":false,"sourceClass":"system"},{"id":"log12","month":24414,"age":7,"fact":{"kind":"year_summary","subjectId":"p1","month":24414,"data":{"age":7,"year":2034,"stage":"childhood","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 7. You are faster than you were a year ago, and you can reach the next shelf up.","templateId":"summary.growing#3","hidden":false,"sourceClass":"system"},{"id":"log15","month":24420,"age":8,"fact":{"kind":"decision_opened","subjectId":"p1","month":24420,"data":{"event":"activity.team","decision":"dec14","optional":true},"significant":false},"text":"Sign-ups for the spring baseball league close at the end of next month. Practice is three afternoons a week, with games on Saturdays.","templateId":"prompt.team#0","hidden":false,"sourceClass":"structural"},{"id":"log16","month":24421,"age":8,"fact":{"kind":"choice","subjectId":"p1","month":24421,"data":{"which":"team_join","lapsed":false},"significant":true},"text":"You sign up. By the third practice your legs ache in a way that feels like progress.","templateId":"activity.choice#0","hidden":false,"sourceClass":"player"},{"id":"log17","month":24426,"age":8,"fact":{"kind":"year_summary","subjectId":"p1","month":24426,"data":{"age":8,"year":2035,"stage":"childhood","trend":"up","cause":"activity.active","illnesses":0,"choices":1,"quiet":false,"highlight":"choice:team_join"},"significant":false},"text":"Age 8. This was the year you joined the team. You have more wind than you did a year ago; serious training is the reason.","templateId":"summary.highlight#13","hidden":false,"sourceClass":"system"},{"id":"log18","month":24438,"age":9,"fact":{"kind":"year_summary","subjectId":"p1","month":24438,"data":{"age":9,"year":2036,"stage":"childhood","trend":"up","cause":"activity.active","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 9. Your body is in better order than it was last year, thanks to serious training.","templateId":"summary.trend_up#1","hidden":false,"sourceClass":"system"},{"id":"log19","month":24450,"age":10,"fact":{"kind":"year_summary","subjectId":"p1","month":24450,"data":{"age":10,"year":2037,"stage":"childhood","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 10. The pencil marks on the door frame move up another two inches.","templateId":"summary.growing#4","hidden":false,"sourceClass":"system"},{"id":"log20","month":24462,"age":11,"fact":{"kind":"year_summary","subjectId":"p1","month":24462,"data":{"age":11,"year":2038,"stage":"childhood","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 11. You are taller by the end of the year, and stronger, and hungry most of the time.","templateId":"summary.growing#5","hidden":false,"sourceClass":"system"},{"id":"log23","month":24470,"age":12,"fact":{"kind":"illness_started","subjectId":"p1","month":24470,"data":{"illness":"flu"},"significant":false,"outcomeId":"out21"},"text":"The flu goes through your class in March, and through you.","templateId":"health.flu#3","hidden":false,"sourceClass":"chance"},{"id":"log24","month":24474,"age":12,"fact":{"kind":"year_summary","subjectId":"p1","month":24474,"data":{"age":12,"year":2039,"stage":"childhood","trend":"up","cause":"growing","illnesses":1,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 12. You grow again; last year's shoes no longer fit. Apart from a bout of flu, you were well.","templateId":"summary.growing#2","hidden":false,"sourceClass":"system"},{"id":"log25","month":24486,"age":13,"fact":{"kind":"year_summary","subjectId":"p1","month":24486,"data":{"age":13,"year":2040,"stage":"adolescence","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 13. You grow in bursts this year, and your coordination takes a while to catch up.","templateId":"summary.growing#6","hidden":false,"sourceClass":"system"},{"id":"log26","month":24498,"age":14,"fact":{"kind":"year_summary","subjectId":"p1","month":24498,"data":{"age":14,"year":2041,"stage":"adolescence","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 14. You are stronger than you were last year without having done much to earn it.","templateId":"summary.growing#7","hidden":false,"sourceClass":"system"},{"id":"log27","month":24510,"age":15,"fact":{"kind":"year_summary","subjectId":"p1","month":24510,"data":{"age":15,"year":2042,"stage":"adolescence","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 15. Your body is still filling out; you are quicker and can go for longer.","templateId":"summary.growing#8","hidden":false,"sourceClass":"system"},{"id":"log28","month":24522,"age":16,"fact":{"kind":"year_summary","subjectId":"p1","month":24522,"data":{"age":16,"year":2043,"stage":"adolescence","trend":"up","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 16. Your body is still filling out; you are quicker and can go for longer.","templateId":"summary.growing#8","hidden":false,"sourceClass":"system"},{"id":"log31","month":24529,"age":17,"fact":{"kind":"illness_started","subjectId":"p1","month":24529,"data":{"illness":"flu"},"significant":false,"outcomeId":"out29"},"text":"You miss a week of school with the flu.","templateId":"health.flu#2","hidden":false,"sourceClass":"chance"},{"id":"log32","month":24534,"age":17,"fact":{"kind":"year_summary","subjectId":"p1","month":24534,"data":{"age":17,"year":2044,"stage":"adolescence","trend":"up","cause":"growing","illnesses":1,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 17. You grow in bursts this year, and your coordination takes a while to catch up. You lost a week or so to the flu.","templateId":"summary.growing#6","hidden":false,"sourceClass":"system"},{"id":"log33","month":24535,"age":18,"fact":{"kind":"milestone","subjectId":"p1","month":24535,"data":{"which":"adult","age":18},"significant":true},"text":"Eighteen. Nothing feels different the morning after, though legally nearly everything is.","templateId":"life.adult#1","hidden":false,"sourceClass":"structural"},{"id":"log34","month":24546,"age":18,"fact":{"kind":"year_summary","subjectId":"p1","month":24546,"data":{"age":18,"year":2045,"stage":"early_adulthood","trend":"flat","cause":"growing","illnesses":0,"choices":0,"quiet":false,"highlight":"milestone:adult"},"significant":false},"text":"Age 18. You became an adult this year, at least in law.","templateId":"summary.highlight#5","hidden":false,"sourceClass":"system"},{"id":"log35","month":24558,"age":19,"fact":{"kind":"year_summary","subjectId":"p1","month":24558,"data":{"age":19,"year":2046,"stage":"early_adulthood","trend":"flat","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 19. Twelve months go by without an event you would put in a letter.","templateId":"summary.quiet#11","hidden":false,"sourceClass":"system"},{"id":"log36","month":24570,"age":20,"fact":{"kind":"year_summary","subjectId":"p1","month":24570,"data":{"age":20,"year":2047,"stage":"early_adulthood","trend":"flat","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 20. The year keeps its shape. Nothing in it is hard to describe and nothing stands out.","templateId":"summary.quiet#9","hidden":false,"sourceClass":"system"},{"id":"log37","month":24582,"age":21,"fact":{"kind":"year_summary","subjectId":"p1","month":24582,"data":{"age":21,"year":2048,"stage":"early_adulthood","trend":"flat","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 21. A steady year. You would have trouble telling it apart from the last one.","templateId":"summary.quiet#10","hidden":false,"sourceClass":"system"},{"id":"log38","month":24594,"age":22,"fact":{"kind":"year_summary","subjectId":"p1","month":24594,"data":{"age":22,"year":2049,"stage":"early_adulthood","trend":"flat","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 22. Twelve months go by without an event you would put in a letter.","templateId":"summary.quiet#11","hidden":false,"sourceClass":"system"},{"id":"log39","month":24606,"age":23,"fact":{"kind":"year_summary","subjectId":"p1","month":24606,"data":{"age":23,"year":2050,"stage":"early_adulthood","trend":"flat","cause":"growing","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 23. A steady year. You would have trouble telling it apart from the last one.","templateId":"summary.quiet#10","hidden":false,"sourceClass":"system"},{"id":"log42","month":24608,"age":24,"fact":{"kind":"decision_opened","subjectId":"p1","month":24608,"data":{"event":"activity.slipping","decision":"dec41","optional":true},"significant":false},"text":"The last two months have been crowded, and your training has been the thing that gives. Your shoes have not left the hallway in three weeks.","templateId":"prompt.slipping#0","hidden":false,"sourceClass":"player"},{"id":"log43","month":24609,"age":24,"fact":{"kind":"choice","subjectId":"p1","month":24609,"data":{"which":"routine_protect","lapsed":false},"significant":false},"text":"You put the sessions back in the calendar and treat them like appointments. Something else will have to give.","templateId":"activity.choice#9","hidden":false,"sourceClass":"player"},{"id":"log44","month":24618,"age":24,"fact":{"kind":"year_summary","subjectId":"p1","month":24618,"data":{"age":24,"year":2051,"stage":"early_adulthood","trend":"flat","cause":"growing","illnesses":0,"choices":1,"quiet":false,"highlight":null},"significant":false},"text":"Age 24. The year keeps its shape. Nothing in it is hard to describe and nothing stands out.","templateId":"summary.quiet#9","hidden":false,"sourceClass":"system"},{"id":"log45","month":24630,"age":25,"fact":{"kind":"year_summary","subjectId":"p1","month":24630,"data":{"age":25,"year":2052,"stage":"early_adulthood","trend":"flat","cause":"aging","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 25. The year keeps its shape. Nothing in it is hard to describe and nothing stands out.","templateId":"summary.quiet#9","hidden":false,"sourceClass":"system"},{"id":"log46","month":24642,"age":26,"fact":{"kind":"year_summary","subjectId":"p1","month":24642,"data":{"age":26,"year":2053,"stage":"early_adulthood","trend":"flat","cause":"aging","illnesses":0,"choices":0,"quiet":true,"highlight":null},"significant":false},"text":"Age 26. A steady year. You would have trouble telling it apart from the last one.","templateId":"summary.quiet#10","hidden":false,"sourceClass":"system"},{"id":"log47","month":24654,"age":27,"fact":{"kind":"year_summary","subjectId":"p1","month":2